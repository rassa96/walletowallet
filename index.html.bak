<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, viewport-fit=cover">

    <!-- font -->
    <link rel="stylesheet" href="fonts/fonts.css">
    <!-- Icons -->
    <link rel="stylesheet" href="icons/icomoon/style.css">
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="css/swiper-bundle.min.css">
    <link rel="manifest" href="_manifest.json" data-pwa-version="set_in_manifest_and_pwa_js">
    <link rel="stylesheet" type="text/css" href="css/styles.css" />


    <!-- Favicon and Touch Icons  -->
    <link rel="shortcut icon" href="images/logo/40.png" />
    <link rel="apple-touch-icon-precomposed" href="images/logo/40.png" />

    <title>EasyPay</title>
</head>

<body class="bg-color-primary-100">

    <!-- preloade -->
    <div class="preload preload-container">
        <div class="logo-img">
            <img src="images/logo/logo.svg" alt="Image">
        </div>
        <div class="spinner-circle lg success">
            <span class="spinner-circle1 spinner-child"></span>
            <span class="spinner-circle2 spinner-child"></span>
            <span class="spinner-circle3 spinner-child"></span>
            <span class="spinner-circle4 spinner-child"></span>
            <span class="spinner-circle5 spinner-child"></span>
            <span class="spinner-circle6 spinner-child"></span>
            <span class="spinner-circle7 spinner-child"></span>
            <span class="spinner-circle8 spinner-child"></span>
            <span class="spinner-circle9 spinner-child"></span>
        </div>
    </div>
    <!-- /preload -->

    <div class="bg-shape-top-h2"></div>
    <div class="main-content pb-100">
        <div class="header-home">
            <div class="tf-container">
                <div class="header-content">
                    <div class="left d-flex align-items-center g-10 wg-user style-white">
                        <div class="image">
                            <img loading="lazy" width="45" height="45" src="images/avatar/avatar-1.jpg" alt="Image">
                        </div>
                        <div class="content">
                            <p class="title fw-5">
                                Hi, Andreas 👋
                            </p>
                            <p class="sub-title text-small">
                                Welcome back to Stock!
                            </p>
                        </div>
                    </div>
                    <div class="right d-flex align-items-center g-5">
                        <a href="chat.html" class="mess-btn btn-icon style-white">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18"
                                fill="none">
                                <path
                                    d="M16.75 7.55V8.75C16.75 12.5212 16.75 14.4069 15.5784 15.5784C14.4069 16.75 12.5212 16.75 8.75 16.75C4.97876 16.75 3.09315 16.75 1.92157 15.5784C0.75 14.4069 0.75 12.5212 0.75 8.75C0.75 4.97876 0.75 3.09315 1.92157 1.92157C3.09315 0.75 4.97876 0.75 8.75 0.75H9.95"
                                    stroke="#FAFBFF" stroke-width="1.5" stroke-linecap="round" />
                                <circle cx="14.35" cy="3.15" r="2.4" fill="#FD6251" />
                                <path d="M4.75 10.35H11.95" stroke="#FAFBFF" stroke-width="1.5"
                                    stroke-linecap="round" />
                                <path d="M4.75 13.15H9.55" stroke="#FAFBFF" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                        </a>
                        <a href="#notification" class="btn-icon style-white" data-bs-toggle="modal">
                            <i class="icon-bell"></i>
                            <span></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="tf-container">
            <div class="asset-card-row mb-24">
                <div class="wg-total-asset-card">
                    <div class="top-card">
                        <div class="text text-small fw-5">
                            Total asset value
                        </div>
                        <div class="price-asset-card h4 d-flex align-items-center g-8 box-auth-pass">
                            <input type="text" value="$18,908.00" class="price password-field2" size="5">
                            <a href="#" class="show-pass2 active">
                                <i class="icon-eye-outline"></i>
                            </a>
                        </div>
                        <p class="d-flex align-items-center g-4"><i class="icon-arrow-circle-up"></i> <span
                                class="text-xsmall">4.78% (+0.20%) vs Last week</span></p>
                    </div>
                    <div class="list-image-logo">
                        <img loading="lazy" width="32" height="32" src="images/icon/amazon.jpg" alt="Image"
                            class="img-logo">
                        <img loading="lazy" width="32" height="32" src="images/icon/airbnb.jpg" alt="Image"
                            class="img-logo">
                        <img loading="lazy" width="32" height="32" src="images/icon/amd.jpg" alt="Image"
                            class="img-logo">
                        <img loading="lazy" width="32" height="32" src="images/icon/zoom.jpg" alt="Image"
                            class="img-logo">
                    </div>
                </div>
                <div class="add-card">
                    <a href="add-new-card.html" class="tf-btn style-3 w-100"><span><i class="icon-plus"></i> Add
                            Card</span></a>
                </div>
            </div>
        </div>

        <div class="tf-container">
            <div class="grid-2 g-8 mb-24">
                <a href="select-contact-all-contact-send.html" class="tf-btn style-2 py-17 style-white">
                    <i class="icon-icon-send"></i>
                    <span>Deposit</span>
                </a>
                <a href="select-contact-all-contact-request.html" class="tf-btn style-2 py-17 style-white">
                    <i class="icon-icon-request"></i>
                    <span>Withdraw</span>
                </a>
            </div>
        </div>

    <!-- truncated for brevity in backup -->
